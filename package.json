{
  "name": "pi-superwhisper-paste",
  "version": "0.1.3",
  "description": "[Archived] Community Pi bridge for Superwhisper on Windows. Use npm:@superwhisper/pi instead.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "superwhisper",
    "clipboard",
    "windows",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-superwhisper-paste.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-superwhisper-paste/issues"
  },
  "homepage": "https://github.com/eiei114/pi-superwhisper-paste#readme",
  "files": [
    "extensions/",
    "lib/",
    "skills/",
    "prompts/",
    "themes/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
