{
  "name": "pi-superwhisper-paste",
  "version": "0.1.27",
  "description": "Superwhisper clipboard bridge for Pi on Windows.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "superwhisper",
    "clipboard",
    "windows",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-superwhisper-paste.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-superwhisper-paste/issues"
  },
  "homepage": "https://github.com/eiei114/pi-superwhisper-paste#readme",
  "files": [
    "extensions/",
    "lib/",
    "skills/",
    "prompts/",
    "themes/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs",
    "version:check": "node scripts/check-version-bump.mjs",
    "smoke:pi:curated": "node scripts/pi-sdk-smoke.mjs --update-curated-report"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2"
  }
}
